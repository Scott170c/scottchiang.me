# Admin dashboard (/admin) auth. Generate with: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fine-grained GitHub PAT scoped to ONLY this repo, with "Contents" set to
# Read and write (no other permissions needed). Without this set, the admin
# dashboard writes directly to data/projects.json on local disk instead --
# useful for `npm run dev`, but on Vercel this must be set since the
# filesystem is read-only in production.
GITHUB_TOKEN=
GITHUB_OWNER=scott170c
GITHUB_REPO=scottchiang.me
GITHUB_BRANCH=main
